# Copy to infra/.env and fill EVERY key. infra/.env is git-ignored; never commit it.
# Keep values simple: no double quotes, backslashes or newlines (they are written into YAML/JSON).

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Keycloak ---
# Keycloak master-realm admin (console at http://localhost:8080)
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# Secret of confidential client `shop-app` in realm `shop`. You choose it; Keycloak imports it into the
# realm and the backend reads the same value from Consul (keycloak.credentials.secret).
KEYCLOAK_CLIENT_SECRET=

# --- MinIO ---
MINIO_ROOT_USER=
# at least 8 characters
MINIO_ROOT_PASSWORD=

# --- Backend (rendered into Consul) ---
# AES key for core: exactly 16, 24 or 32 ASCII characters
APP_CRYPTO_KEY=
# Optional. Empty = chatbot uses the rule-based fallback only.
ANTHROPIC_API_KEY=

# --- Admin bootstrap (scripts/bootstrap-admin) ---
SHOP_ADMIN_USERNAME=
SHOP_ADMIN_PASSWORD=
SHOP_ADMIN_EMAIL=
SHOP_ADMIN_FULL_NAME=
# Role code (sa_role.code) granted to the admin; must already exist (seeded by db/03-seed.sql)
SHOP_ADMIN_ROLE_CODE=

# --- Optional overrides (leave unset to use the pinned defaults in docker-compose.yml) ---
# MINIO_IMAGE=
# MC_IMAGE=
