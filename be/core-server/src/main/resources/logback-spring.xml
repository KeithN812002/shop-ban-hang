        <root level="INFO">
            <appender-ref ref="ConsoleAppender"/>
            <appender-ref ref="JSON_FILE" />
            <appender-ref ref="DEBUG_FILE"/>
        </root>
        <logger name="com.fpt.server" level="TRACE" additivity="false">
            <appender-ref ref="ConsoleAppender"/>
            <appender-ref ref="JSON_FILE"/>
            <appender-ref ref="DEBUG_FILE"/>
        </logger>
    </springProfile> -->
</configuration>
