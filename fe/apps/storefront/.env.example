# Dev server (default 3000, strict)
FIS_SERVER_PORT=

# Backend origin the Vite dev proxy forwards /api/* to (default http://localhost:8200)
FIS_API_BASE_URL=

# URL prefix the browser calls (default /api). Change only when a reverse proxy uses another prefix.
FIS_API_PREFIX=

# Keycloak SSO (same client the backend uses to exchange the authorization code)
FIS_SSO_URL=
FIS_REALM=
FIS_CLIENT_ID=
# Optional: defaults to <origin>/auth/callback. Must be a valid redirect URI of the Keycloak client.
FIS_REDIRECT_URL=

# Optional AR overrides (defaults: jsdelivr wasm for the installed version + official model storage)
FIS_AR_WASM_URL=
FIS_AR_FACE_MODEL_URL=
FIS_AR_POSE_MODEL_URL=
