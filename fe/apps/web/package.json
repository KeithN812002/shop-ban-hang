{
    "name": "web",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:stagging": "vite --mode stagging",
        "dev:uat": "vite --mode uat",
        "dev:production": "vite --mode production",
        "build": "vite build && tsc --noEmit",
        "build:stagging": "vite build --mode stagging && tsc --noEmit",
        "build:uat": "vite build --mode uat && tsc --noEmit",
        "build:production": "vite build --mode production && tsc --noEmit",
        "serve": "vite preview",
        "serve:stagging": "vite preview --mode stagging",
        "serve:uat": "vite preview --mode uat",
        "serve:production": "vite preview --mode production",
        "start": "vite"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.90.21",
        "@tanstack/react-query-devtools": "^5.91.3",
        "@tanstack/react-router": "^1.170.44",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/router-plugin": "^1.168.45",
        "@workspace/lib": "workspace:*",
        "@workspace/ui": "workspace:*",
        "axios": "^1.12.2",
        "dayjs": "^1.11.23",
        "i18next": "^24.2.0",
        "i18next-browser-languagedetector": "^8.2.1",
        "lucide-react": "^0.475.0",
        "nuqs": "^2.8.9",
        "react": "^19.1.1",
        "react-aria": "^3.44.0",
        "react-aria-components": "^1.13.0",
        "react-dom": "^19.1.1",
        "react-hook-form": "^7.71.2",
        "react-i18next": "^15.7.4",
        "socket.io-client": "^4.8.4",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^4.3.4",
        "@workspace/eslint-config": "workspace:^",
        "@workspace/typescript-config": "workspace:*",
        "typescript": "^5.9.2",
        "vite": "^7.3.7"
    }
}
