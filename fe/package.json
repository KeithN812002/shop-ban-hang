{
    "name": "core-fe",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "format": "prettier . --write",
        "prepare": "lefthook install",
        "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.turbo packages/*/.turbo",
        "reinstall": "pnpm clean && pnpm install"
    },
    "devDependencies": {
        "@workspace/eslint-config": "workspace:*",
        "@workspace/typescript-config": "workspace:*",
        "lefthook": "^1.11.8",
        "prettier": "^3.8.5",
        "tsx": "^4.21.1",
        "turbo": "^2.10.13",
        "typescript": "^5.9.2",
        "vite-plugin-compression2": "^2.4.0"
    },
    "packageManager": "pnpm@10.4.1",
    "engines": {
        "node": ">=20"
    },
    "pnpm": {
        "overrides": {
            "axios": "1.20.0",
            "turbo": "2.10.13",
            "lodash": "4.18.1",
            "esbuild": "0.28.1",
            "ws": "8.22.0",
            "follow-redirects": "1.16.0",
            "form-data": "4.0.6",
            "postcss": "8.5.29",
            "react": "19.2.8",
            "react-dom": "19.2.8",
            "socket.io-parser": "4.2.7",
            "source-map-js": "1.2.2",
            "mime-types@2": "3.0.2",
            "postcss-selector-parser@6": "7.1.6"
        }
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.1",
        "react-hook-form": "^7.71.2",
        "zustand": "^5.0.15"
    }
}
